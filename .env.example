# Local only; copy to .env and use your own Shopify app credentials. Never commit .env.
SHOPIFY_APP_URL=https://blockbuilder.task19.com
SHOPIFY_API_KEY=your-client-id
SHOPIFY_API_SECRET=your-client-secret
DATABASE_URL=file:./dev.sqlite

# Shopify App Pricing. Create a Partner API client with Manage apps permission.
# The app ID is the numeric ID in the Shopify Dev/Partner Dashboard URL.
SHOPIFY_PARTNER_ORG_ID=your-numeric-partner-organization-id
SHOPIFY_PARTNER_APP_ID=your-numeric-app-id
SHOPIFY_PARTNER_API_TOKEN=your-partner-api-client-token
SHOPIFY_APP_HANDLE=your-shopify-app-handle
# Set these only if your plan handles differ from free, starter, and pro.
# SHOPIFY_FREE_PLAN_HANDLE=free
# SHOPIFY_STARTER_PLAN_HANDLE=starter
# SHOPIFY_PRO_PLAN_HANDLE=pro

{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
{% assign policy_link = block.settings.link %}
{% if policy_link == blank and block.settings.auto_policy_link and shop.shipping_policy.url != blank %}{% assign policy_link = shop.shipping_policy.url %}{% endif %}
{% if block.settings.body != blank %}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-shipping-details bb-shipping-details--{{ block.settings.style | escape }}"{% render "sectionkit-colors", block: block %} {{ block.shopify_attributes }}>
  <span class="bb-shipping-details__icon" aria-hidden="true">↗</span>
  <div><strong>{{ block.settings.heading | escape }}</strong><p>{{ block.settings.body | escape | newline_to_br }}</p>{% if policy_link != blank %}<a href="{{ policy_link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div>
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Enter your store's shipping details to show this block.</div>{% endif %}
{%- endif -%}
{% schema %}
{"name":"Shipping details","target":"section","enabled_on":{"templates":["product"]},"stylesheet":"block-builder.css","settings":[{"type":"select","id":"style","label":"Design","options":[{"value":"standard","label":"Standard"},{"value":"outline","label":"Outline"},{"value":"warm","label":"Warm"}],"default":"standard"},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"link_color","label":"Link color","info":"Leave empty to use the selected design. Custom colors require Starter or Pro."},{"type":"text","id":"heading","label":"Heading","default":"Shipping details"},{"type":"textarea","id":"body","label":"Your shipping terms","info":"Use terms that match your store policies."},{"type":"url","id":"link","label":"Custom policy link","info":"Overrides the store shipping policy link."},{"type":"checkbox","id":"auto_policy_link","label":"Link to store shipping policy","default":true,"info":"Used when no custom policy link is set and the store has this policy."},{"type":"text","id":"link_label","label":"Link label","default":"Read shipping policy"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}]}
{% endschema %}

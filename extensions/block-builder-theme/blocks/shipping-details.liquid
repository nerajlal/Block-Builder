{% if block.settings.body != blank %}
<div class="bb-block bb-shipping-details bb-shipping-details--{{ block.settings.style | escape }}" {% if block.settings.background_color != blank %} data-bb-bg{% endif %}{% if block.settings.text_color != blank %} data-bb-text{% endif %}{% if block.settings.border_color != blank %} data-bb-border{% endif %}{% if block.settings.accent_color != blank %} data-bb-accent{% endif %}{% if block.settings.background_color != blank or block.settings.text_color != blank or block.settings.border_color != blank or block.settings.accent_color != blank or block.settings.link_color != blank %} style="{% if block.settings.background_color != blank %}--bb-custom-bg:{{ block.settings.background_color | escape }};{% endif %}{% if block.settings.text_color != blank %}--bb-custom-text:{{ block.settings.text_color | escape }};{% endif %}{% if block.settings.border_color != blank %}--bb-custom-border:{{ block.settings.border_color | escape }};{% endif %}{% if block.settings.accent_color != blank %}--bb-custom-accent:{{ block.settings.accent_color | escape }};{% endif %}{% if block.settings.link_color != blank %}--bb-shipping-link:{{ block.settings.link_color | escape }};{% endif %}"{% endif %} {{ block.shopify_attributes }}>
  <span class="bb-shipping-details__icon" aria-hidden="true">↗</span>
  <div><strong>{{ block.settings.heading | escape }}</strong><p>{{ block.settings.body | escape | newline_to_br }}</p>{% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div>
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Enter your store's shipping details to show this block.</div>{% endif %}
{% schema %}
{
  "name": "Shipping details",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Design",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "warm",
          "label": "Warm"
        }
      ],
      "default": "standard"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the selected design."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the selected design."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the selected design."
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "info": "Leave empty to use the selected design."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping details"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Your shipping terms",
      "info": "Use terms that match your store policies."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Shipping policy link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read shipping policy"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design."
    }
  ]
}
{% endschema %}

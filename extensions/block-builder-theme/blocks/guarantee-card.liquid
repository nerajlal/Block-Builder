{%- assign skc = block.settings -%}
{% assign policy_link = block.settings.link %}
{% if policy_link == blank and block.settings.auto_policy_link and shop.refund_policy.url != blank %}{% assign policy_link = shop.refund_policy.url %}{% endif %}
{% if block.settings.body != blank %}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-guarantee bb-guarantee--{{ block.settings.style | escape }}"{% if skc.background_color != blank %} data-bb-bg{% endif %}{% if skc.text_color != blank %} data-bb-text{% endif %}{% if skc.border_color != blank %} data-bb-border{% endif %}{% if skc.accent_color != blank %} data-bb-accent{% endif %} style="{% if skc.background_color != blank %}--bb-custom-bg:{{ skc.background_color | escape }};{% endif %}{% if skc.text_color != blank %}--bb-custom-text:{{ skc.text_color | escape }};{% endif %}{% if skc.border_color != blank %}--bb-custom-border:{{ skc.border_color | escape }};{% endif %}{% if skc.accent_color != blank %}--bb-custom-accent:{{ skc.accent_color | escape }};{% endif %}" {{ block.shopify_attributes }}>
  <span class="bb-guarantee__icon" aria-hidden="true">✓</span>
  <div><strong>{{ block.settings.heading | escape }}</strong><p>{{ block.settings.body | escape | newline_to_br }}</p>{% if policy_link != blank %}<a href="{{ policy_link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div>
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Describe a guarantee your store actually offers.</div>{% endif %}
{% schema %}
{"name":"Guarantee card","target":"section","enabled_on":{"templates":["product"]},"stylesheet":"block-builder.css","settings":[{"type":"select","id":"style","label":"Design","options":[{"value":"standard","label":"Standard"},{"value":"outline","label":"Outline"},{"value":"warm","label":"Warm"}],"default":"standard"},{"type":"text","id":"heading","label":"Heading","default":"Our promise"},{"type":"textarea","id":"body","label":"Your actual guarantee","info":"Only describe a policy your store offers."},{"type":"url","id":"link","label":"Custom policy link","info":"Overrides the store refund policy link."},{"type":"checkbox","id":"auto_policy_link","label":"Link to store refund policy","default":true,"info":"Used when no custom policy link is set and the store has this policy."},{"type":"text","id":"link_label","label":"Link label","default":"Read the policy"},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}]}
{% endschema %}

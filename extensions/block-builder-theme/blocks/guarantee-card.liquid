{% if block.settings.body != blank %}
<div class="bb-block bb-guarantee bb-guarantee--{{ block.settings.style | escape }}" {{ block.shopify_attributes }}>
  <span class="bb-guarantee__icon" aria-hidden="true">✓</span>
  <div><strong>{{ block.settings.heading | escape }}</strong><p>{{ block.settings.body | escape | newline_to_br }}</p>{% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div>
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Describe a guarantee your store actually offers.</div>{% endif %}
{% schema %}
{
  "name": "Guarantee card",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "settings": [
    {"type": "select", "id": "style", "label": "Design", "options": [{"value": "standard", "label": "Standard"}, {"value": "outline", "label": "Outline"}, {"value": "warm", "label": "Warm"}], "default": "standard"},
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our promise"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Your actual guarantee",
      "info": "Only describe a policy your store offers."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Policy link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Read the policy"
    }
  ]
}
{% endschema %}

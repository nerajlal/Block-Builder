{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-faq"{% render "sectionkit-colors", block: block %}><h3>{{ block.settings.heading | escape }}</h3>
  {% if block.settings.question_1 != blank %}<details><summary>{{ block.settings.question_1 | escape }}</summary><p>{{ block.settings.answer_1 | escape | newline_to_br }}</p></details>{% endif %}
  {% if block.settings.question_2 != blank %}<details><summary>{{ block.settings.question_2 | escape }}</summary><p>{{ block.settings.answer_2 | escape | newline_to_br }}</p></details>{% endif %}
  {% if block.settings.question_3 != blank %}<details><summary>{{ block.settings.question_3 | escape }}</summary><p>{{ block.settings.answer_3 | escape | newline_to_br }}</p></details>{% endif %}
</div>
{%- endif -%}
{% schema %}
{"name":"Product FAQ","target":"section","enabled_on":{"templates":["product"]},"stylesheet":"block-builder.css","settings":[{"type":"text","id":"heading","label":"Heading","default":"Good to know"},{"type":"text","id":"question_1","label":"Question 1","default":"How do I care for this?"},{"type":"textarea","id":"answer_1","label":"Answer 1","default":"Add your care instructions here."},{"type":"text","id":"question_2","label":"Question 2","default":"When will it arrive?"},{"type":"textarea","id":"answer_2","label":"Answer 2","default":"Add your delivery information here."},{"type":"text","id":"question_3","label":"Question 3","default":"Can I return it?"},{"type":"textarea","id":"answer_3","label":"Answer 3","default":"Add your return policy summary here."},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}]}
{% endschema %}

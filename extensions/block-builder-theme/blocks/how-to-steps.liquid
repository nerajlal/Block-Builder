{% if block.settings.body_1 != blank or block.settings.body_2 != blank or block.settings.body_3 != blank %}
<div class="bb-block bb-steps" {{ block.shopify_attributes }}>
  <h3>{{ block.settings.heading | escape }}</h3>
  <div class="bb-steps__grid">
    {% for number in (1..3) %}
      {% assign title_key = 'title_' | append: number %}
      {% assign body_key = 'body_' | append: number %}
      {% if block.settings[body_key] != blank %}<div class="bb-steps__item"><span class="bb-steps__number">{{ number }}</span><strong>{{ block.settings[title_key] | escape }}</strong><p>{{ block.settings[body_key] | escape }}</p></div>{% endif %}
    {% endfor %}
  </div>
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Describe at least one step to show this block.</div>{% endif %}
{% schema %}
{
  "name": "How-to steps",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How to use it"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Step 1 title",
      "default": "Step 1"
    },
    {
      "type": "textarea",
      "id": "body_1",
      "label": "Step 1 details"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Step 2 title",
      "default": "Step 2"
    },
    {
      "type": "textarea",
      "id": "body_2",
      "label": "Step 2 details"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Step 3 title",
      "default": "Step 3"
    },
    {
      "type": "textarea",
      "id": "body_3",
      "label": "Step 3 details"
    }
  ]
}
{% endschema %}

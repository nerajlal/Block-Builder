<div class="bb-block bb-story{% if block.settings.image == blank %} bb-story--no-image{% endif %}">
  {% if block.settings.image != blank %}<div class="bb-story__image">{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}</div>{% endif %}
  <div class="bb-story__copy"><span>{{ block.settings.eyebrow | escape }}</span><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.body | escape | newline_to_br }}</p></div>
</div>
{% schema %}
{
  "name": "Image Story",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The details matter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made with care"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Tell shoppers what makes this product special."
    }
  ]
}
{% endschema %}

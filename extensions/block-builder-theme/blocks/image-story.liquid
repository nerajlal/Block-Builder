{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-story{% if block.settings.image == blank %} bb-story--no-image{% endif %}"{% render "sectionkit-colors", block: block %}>
  {% if block.settings.image != blank %}<div class="bb-story__image">{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}</div>{% endif %}
  <div class="bb-story__copy"><span>{{ block.settings.eyebrow | escape }}</span><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.body | escape | newline_to_br }}</p></div>
</div>
{%- endif -%}
{% schema %}
{"name":"Image Story","target":"section","available_if":"{{ app.metafields.sectionkit.allow_image_story }}","enabled_on":{"templates":["product"]},"stylesheet":"block-builder.css","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The details matter"},{"type":"text","id":"heading","label":"Heading","default":"Made with care"},{"type":"textarea","id":"body","label":"Body","default":"Tell shoppers what makes this product special."},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}]}
{% endschema %}

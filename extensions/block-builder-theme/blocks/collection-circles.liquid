{% if block.settings.collections != blank %}
<div class="bb-block bb-collection-circles" {% render 'block-color-attributes', block: block %} {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
  <div class="bb-collection-circles__grid">
    {% for chosen in block.settings.collections limit: 3 %}
        <a href="{{ chosen.url | escape }}" class="bb-collection-circles__item">
          <span class="bb-collection-circles__image">
            {% assign image = chosen.image | default: chosen.products.first.featured_image %}
            {% if image != blank %}{{ image | image_url: width: 320 | image_tag: loading: 'lazy', alt: chosen.title }}{% else %}<span aria-hidden="true">{{ chosen.title | slice: 0, 1 | escape }}</span>{% endif %}
          </span>
          <span>{{ chosen.title | escape }}</span>
        </a>
    {% endfor %}
  </div>
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Select collections to show them here.</div>{% endif %}
{% schema %}
{
  "name": "Collection circles",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore collections"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 3
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design."
    }
  ]
}
{% endschema %}

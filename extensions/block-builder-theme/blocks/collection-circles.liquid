{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
{% if block.settings.collections != blank %}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-collection-circles"{% render "sectionkit-colors", block: block %} {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
  <div class="bb-collection-circles__grid">
    {% for chosen in block.settings.collections limit: 3 %}
        <a href="{{ chosen.url | escape }}" class="bb-collection-circles__item">
          <span class="bb-collection-circles__image">
            {% assign image = chosen.image | default: chosen.products.first.featured_image %}
            {% if image != blank %}{{ image | image_url: width: 320 | image_tag: loading: 'lazy', alt: chosen.title }}{% else %}<span aria-hidden="true">{{ chosen.title | slice: 0, 1 | escape }}</span>{% endif %}
          </span>
          <span>{{ chosen.title | escape }}</span>
        </a>
    {% endfor %}
  </div>
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Select collections to show them here.</div>{% endif %}
{%- endif -%}
{% schema %}
{"name":"Collection circles","target":"section","available_if":"{{ app.metafields.sectionkit.allow_collection_circles }}","enabled_on":{"templates":["product"]},"stylesheet":"block-builder.css","settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore collections"},{"type":"collection_list","id":"collections","label":"Collections","limit":3},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}]}
{% endschema %}

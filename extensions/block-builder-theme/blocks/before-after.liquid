{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
{% if block.settings.before_image != blank and block.settings.after_image != blank %}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-before-after" data-bb-before-after style="--bb-split:50%;{% if block.settings.background_color != blank %}--bb-custom-bg:{{ block.settings.background_color | escape }};{% endif %}{% if block.settings.text_color != blank %}--bb-custom-text:{{ block.settings.text_color | escape }};{% endif %}{% if block.settings.border_color != blank %}--bb-custom-border:{{ block.settings.border_color | escape }};{% endif %}{% if block.settings.accent_color != blank %}--bb-custom-accent:{{ block.settings.accent_color | escape }};{% endif %}" {% if block.settings.background_color != blank %} data-bb-bg{% endif %}{% if block.settings.text_color != blank %} data-bb-text{% endif %}{% if block.settings.border_color != blank %} data-bb-border{% endif %}{% if block.settings.accent_color != blank %} data-bb-accent{% endif %}><div class="bb-before-after__images">
  {{ block.settings.before_image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'bb-before-after__before' }}
  <div class="bb-before-after__after">{{ block.settings.after_image | image_url: width: 1200 | image_tag: loading: 'lazy' }}</div>
  <span class="bb-before-after__line" aria-hidden="true"></span>
  <span class="bb-before-after__label bb-before-after__label--before">{{ block.settings.before_label | escape }}</span><span class="bb-before-after__label bb-before-after__label--after">{{ block.settings.after_label | escape }}</span>
</div><label class="bb-before-after__control">Move to compare images<input type="range" min="0" max="100" value="50" aria-label="Compare before and after images"></label></div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note">Select both before and after images to show this comparison.</div>{% endif %}
{%- endif -%}
{% schema %}
{
  "name": "Before & After",
  "target": "section",
  "available_if": "{{ app.metafields.sectionkit.allow_before_after }}",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "settings": [
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design. Custom colors require Starter or Pro."
},
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design. Custom colors require Starter or Pro."
},
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design. Custom colors require Starter or Pro."
},
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design. Custom colors require Starter or Pro."
},
    {"type": "header", "content": "Pro: display targeting"},
    {"type": "textarea", "id": "pro_product_handles", "label": "Product handles (Pro only)", "info": "Comma-separated handles. Leave empty for all products."},
    {"type": "textarea", "id": "pro_collection_handles", "label": "Collection handles (Pro only)", "info": "Comma-separated handles. Match any collection."},
    {"type": "textarea", "id": "pro_tags", "label": "Product tags (Pro only)", "info": "Comma-separated tags. Match any tag."},
    {"type": "text", "id": "pro_countries", "label": "Country codes (Pro only)", "info": "Comma-separated two-letter market country codes."},
    {"type": "text", "id": "pro_languages", "label": "Language codes (Pro only)", "info": "Comma-separated language codes, for example en,fr."}
  ],
  "javascript": "before-after.js"
}
{% endschema %}

{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
{% if block.settings.body_1 != blank and block.settings.body_2 != blank and block.settings.body_3 != blank %}<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-feature-grid"{% render "sectionkit-colors", block: block %} {{ block.shopify_attributes }}><h3>{{ block.settings.heading | escape }}</h3><div class="bb-feature-grid__items"><div><span aria-hidden="true">✦</span><strong>{{ block.settings.title_1 | escape }}</strong><p>{{ block.settings.body_1 | escape }}</p></div><div><span aria-hidden="true">✦</span><strong>{{ block.settings.title_2 | escape }}</strong><p>{{ block.settings.body_2 | escape }}</p></div><div><span aria-hidden="true">✦</span><strong>{{ block.settings.title_3 | escape }}</strong><p>{{ block.settings.body_3 | escape }}</p></div></div></div>{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Enter three factual product features to show this block.</div>{% endif %}
{%- endif -%}
{% schema %}
{"name":"Feature grid","target":"section","enabled_on":{"templates":["product"]},"stylesheet":"block-builder.css","settings":[{"type":"text","id":"heading","label":"Heading","default":"Why choose this product"},{"type":"text","id":"title_1","label":"Feature 1 title","default":"Feature 1"},{"type":"text","id":"body_1","label":"Feature 1 detail","info":"Use a factual benefit of this product."},{"type":"text","id":"title_2","label":"Feature 2 title","default":"Feature 2"},{"type":"text","id":"body_2","label":"Feature 2 detail","info":"Use a factual benefit of this product."},{"type":"text","id":"title_3","label":"Feature 3 title","default":"Feature 3"},{"type":"text","id":"body_3","label":"Feature 3 detail","info":"Use a factual benefit of this product."},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}]}
{% endschema %}

{% if block.settings.body_1 != blank and block.settings.body_2 != blank and block.settings.body_3 != blank %}<div class="bb-block bb-feature-grid" {% if block.settings.background_color != blank %} data-bb-bg{% endif %}{% if block.settings.text_color != blank %} data-bb-text{% endif %}{% if block.settings.border_color != blank %} data-bb-border{% endif %}{% if block.settings.accent_color != blank %} data-bb-accent{% endif %}{% if block.settings.background_color != blank or block.settings.text_color != blank or block.settings.border_color != blank or block.settings.accent_color != blank %} style="{% if block.settings.background_color != blank %}--bb-custom-bg:{{ block.settings.background_color | escape }};{% endif %}{% if block.settings.text_color != blank %}--bb-custom-text:{{ block.settings.text_color | escape }};{% endif %}{% if block.settings.border_color != blank %}--bb-custom-border:{{ block.settings.border_color | escape }};{% endif %}{% if block.settings.accent_color != blank %}--bb-custom-accent:{{ block.settings.accent_color | escape }};{% endif %}"{% endif %} {{ block.shopify_attributes }}><h3>{{ block.settings.heading | escape }}</h3><div class="bb-feature-grid__items"><div><span aria-hidden="true">✦</span><strong>{{ block.settings.title_1 | escape }}</strong><p>{{ block.settings.body_1 | escape }}</p></div><div><span aria-hidden="true">✦</span><strong>{{ block.settings.title_2 | escape }}</strong><p>{{ block.settings.body_2 | escape }}</p></div><div><span aria-hidden="true">✦</span><strong>{{ block.settings.title_3 | escape }}</strong><p>{{ block.settings.body_3 | escape }}</p></div></div></div>{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Enter three factual product features to show this block.</div>{% endif %}
{% schema %}
{
  "name": "Feature grid",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why choose this product"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Feature 1 title",
      "default": "Feature 1"
    },
    {
      "type": "text",
      "id": "body_1",
      "label": "Feature 1 detail",
      "info": "Use a factual benefit of this product."
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Feature 2 title",
      "default": "Feature 2"
    },
    {
      "type": "text",
      "id": "body_2",
      "label": "Feature 2 detail",
      "info": "Use a factual benefit of this product."
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Feature 3 title",
      "default": "Feature 3"
    },
    {
      "type": "text",
      "id": "body_3",
      "label": "Feature 3 detail",
      "info": "Use a factual benefit of this product."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design."
    }
  ]
}
{% endschema %}

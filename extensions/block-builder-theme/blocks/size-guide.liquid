{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
{% assign has_size = false %}
{% for number in (1..3) %}{% assign key = 'size_' | append: number %}{% if block.settings[key] != blank %}{% assign has_size = true %}{% endif %}{% endfor %}
{% if has_size %}
<details class="bb-block bb-size-guide" {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }}</summary><div class="bb-size-guide__content"><table><thead><tr><th scope="col">{{ block.settings.label_heading | escape }}</th><th scope="col">{{ block.settings.measurement_heading | escape }}</th></tr></thead><tbody>
{% for number in (1..3) %}{% assign size_key = 'size_' | append: number %}{% assign measurement_key = 'measurement_' | append: number %}{% if block.settings[size_key] != blank %}<tr><th scope="row">{{ block.settings[size_key] | escape }}</th><td>{{ block.settings[measurement_key] | escape }}</td></tr>{% endif %}{% endfor %}
</tbody></table>{% if block.settings.note != blank %}<p>{{ block.settings.note | escape }}</p>{% endif %}</div></details>
{% elsif request.design_mode %}<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-editor-note"{% render "sectionkit-colors", block: block %} {{ block.shopify_attributes }}>Add at least one real size and measurement.</div>{% endif %}
{%- endif -%}
{% schema %}
{"name":"Size guide","target":"section","enabled_on":{"templates":["product"]},"stylesheet":"block-builder.css","settings":[{"type":"text","id":"heading","label":"Heading","default":"Size guide"},{"type":"text","id":"label_heading","label":"Size column","default":"Size"},{"type":"text","id":"measurement_heading","label":"Measurement column","default":"Measurement"},{"type":"text","id":"size_1","label":"Size 1"},{"type":"text","id":"measurement_1","label":"Measurement 1"},{"type":"text","id":"size_2","label":"Size 2"},{"type":"text","id":"measurement_2","label":"Measurement 2"},{"type":"text","id":"size_3","label":"Size 3"},{"type":"text","id":"measurement_3","label":"Measurement 3"},{"type":"textarea","id":"note","label":"Optional sizing note"},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}]}
{% endschema %}

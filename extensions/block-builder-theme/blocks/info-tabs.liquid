{%- assign skc = block.settings -%}
{% assign has_tab_content = false %}{% if block.settings.tab_1_body != blank or block.settings.tab_2_body != blank or block.settings.tab_3_body != blank %}{% assign has_tab_content = true %}{% endif %}
{% if has_tab_content %}<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-info-tabs"{% if skc.background_color != blank %} data-bb-bg{% endif %}{% if skc.text_color != blank %} data-bb-text{% endif %}{% if skc.border_color != blank %} data-bb-border{% endif %}{% if skc.accent_color != blank %} data-bb-accent{% endif %} style="{% if skc.background_color != blank %}--bb-custom-bg:{{ skc.background_color | escape }};{% endif %}{% if skc.text_color != blank %}--bb-custom-text:{{ skc.text_color | escape }};{% endif %}{% if skc.border_color != blank %}--bb-custom-border:{{ skc.border_color | escape }};{% endif %}{% if skc.accent_color != blank %}--bb-custom-accent:{{ skc.accent_color | escape }};{% endif %}" data-bb-info-tabs><div class="bb-info-tabs__list" role="tablist" aria-label="Product information">
{% for number in (1..3) %}{% assign body_key = 'tab_' | append: number | append: '_body' %}{% assign title_key = 'tab_' | append: number | append: '_title' %}{% if block.settings[body_key] != blank %}<button type="button" role="tab" id="bb-tab-{{ block.id }}-{{ number }}" aria-controls="bb-panel-{{ block.id }}-{{ number }}" aria-selected="false" tabindex="-1">{{ block.settings[title_key] | escape }}</button>{% endif %}{% endfor %}</div>
{% for number in (1..3) %}{% assign body_key = 'tab_' | append: number | append: '_body' %}{% if block.settings[body_key] != blank %}<div role="tabpanel" id="bb-panel-{{ block.id }}-{{ number }}" aria-labelledby="bb-tab-{{ block.id }}-{{ number }}" hidden>{{ block.settings[body_key] | escape | newline_to_br }}</div>{% endif %}{% endfor %}
</div>{% elsif request.design_mode %}<div class="bb-block bb-editor-note">Add product information to at least one tab.</div>{% endif %}
{% schema %}
{"name":"Information Tabs","target":"section","enabled_on":{"templates":["product"]},"stylesheet":"block-builder.css","settings":[{"type":"text","id":"tab_1_title","label":"Tab 1 title","default":"Materials"},{"type":"textarea","id":"tab_1_body","label":"Tab 1 content"},{"type":"text","id":"tab_2_title","label":"Tab 2 title","default":"Care"},{"type":"textarea","id":"tab_2_body","label":"Tab 2 content"},{"type":"text","id":"tab_3_title","label":"Tab 3 title","default":"Delivery"},{"type":"textarea","id":"tab_3_body","label":"Tab 3 content"},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}],"javascript":"info-tabs.js"}
{% endschema %}

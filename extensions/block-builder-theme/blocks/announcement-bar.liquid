{% if block.settings.message != blank %}
<div class="bb-block bb-announcement bb-announcement--{{ block.settings.style | escape }}" {% render 'block-color-attributes', block: block %} {{ block.shopify_attributes }}>
  <strong>{{ block.settings.heading | escape }}</strong>
  <span>{{ block.settings.message | escape }}</span>
  {% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Enter your announcement message to show this block.</div>{% endif %}
{% schema %}
{
  "name": "Product announcement",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Store update"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "dark",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design."
    }
  ]
}
{% endschema %}

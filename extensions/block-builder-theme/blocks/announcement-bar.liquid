{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
{% if block.settings.message != blank %}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-announcement bb-announcement--{{ block.settings.style | escape }} bb-announcement--{{ block.settings.layout | escape }}"{% render "sectionkit-colors", block: block %} {{ block.shopify_attributes }}>
  {% if block.settings.layout == 'ticker' %}
    <div class="bb-announcement__ticker"><span>{{ block.settings.heading | escape }} · {{ block.settings.message | escape }}</span><span aria-hidden="true">{{ block.settings.heading | escape }} · {{ block.settings.message | escape }}</span></div>
  {% else %}
    <strong>{{ block.settings.heading | escape }}</strong>
    <span>{{ block.settings.message | escape }}</span>
    {% if block.settings.layout == 'coupon' and block.settings.code != blank %}<span class="bb-announcement__coupon"><code id="bb-announcement-code-{{ block.id }}">{{ block.settings.code | escape }}</code><button type="button" data-bb-announcement-copy="bb-announcement-code-{{ block.id }}">Copy code</button></span>{% endif %}
    {% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}
  {% endif %}
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Enter your announcement message to show this block.</div>{% endif %}
{%- endif -%}
{% schema %}
{"name":"Product announcement","target":"section","available_if":"{{ app.metafields.sectionkit.allow_announcement_bar }}","enabled_on":{"templates":["product"]},"stylesheet":"block-builder.css","javascript":"announcement-bar.js","settings":[{"type":"text","id":"heading","label":"Heading","default":"Store update"},{"type":"text","id":"message","label":"Message"},{"type":"url","id":"link","label":"Optional link"},{"type":"text","id":"link_label","label":"Link label","default":"Explore"},{"type":"select","id":"layout","label":"Layout","options":[{"value":"standard","label":"Standard"},{"value":"ticker","label":"Scrolling message"},{"value":"coupon","label":"Responsive coupon"}],"default":"standard"},{"type":"text","id":"code","label":"Existing Shopify discount code","info":"Only shown in Responsive coupon. Create and test the code in Shopify Discounts first."},{"type":"select","id":"style","label":"Style","default":"dark","options":[{"value":"dark","label":"Dark"},{"value":"cream","label":"Cream"},{"value":"outline","label":"Outline"}]},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}]}
{% endschema %}

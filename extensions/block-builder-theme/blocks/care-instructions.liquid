{% if block.settings.instructions != blank %}<div class="bb-block bb-care" {% render 'block-color-attributes', block: block %} {{ block.shopify_attributes }}><span class="bb-care__icon" aria-hidden="true">✦</span><div><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.instructions | escape | newline_to_br }}</p></div></div>{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Enter care instructions to show this block.</div>{% endif %}
{% schema %}
{
  "name": "Care instructions",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Care instructions"
    },
    {
      "type": "textarea",
      "id": "instructions",
      "label": "Product care instructions",
      "info": "Use care advice that applies to this product."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design."
    }
  ]
}
{% endschema %}

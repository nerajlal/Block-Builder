{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign show_quantity = false %}
{% if block.settings.show_low_stock and selected_variant.available and selected_variant.inventory_management == 'shopify' and selected_variant.inventory_policy == 'deny' and selected_variant.inventory_quantity > 0 and selected_variant.inventory_quantity <= block.settings.low_stock_threshold %}{% assign show_quantity = true %}{% endif %}
<div class="bb-block bb-stock{% unless selected_variant.available %} bb-stock--out{% endunless %}" data-bb-low-enabled="{{ block.settings.show_low_stock }}" data-bb-low-threshold="{{ block.settings.low_stock_threshold }}" {% if block.settings.background_color != blank %} data-bb-bg{% endif %}{% if block.settings.text_color != blank %} data-bb-text{% endif %}{% if block.settings.border_color != blank %} data-bb-border{% endif %}{% if block.settings.accent_color != blank %} data-bb-accent{% endif %}{% if block.settings.background_color != blank or block.settings.text_color != blank or block.settings.border_color != blank or block.settings.accent_color != blank %} style="{% if block.settings.background_color != blank %}--bb-custom-bg:{{ block.settings.background_color | escape }};{% endif %}{% if block.settings.text_color != blank %}--bb-custom-text:{{ block.settings.text_color | escape }};{% endif %}{% if block.settings.border_color != blank %}--bb-custom-border:{{ block.settings.border_color | escape }};{% endif %}{% if block.settings.accent_color != blank %}--bb-custom-accent:{{ block.settings.accent_color | escape }};{% endif %}"{% endif %} data-bb-stock role="status" aria-live="polite">
  <span data-bb-stock-available{% if show_quantity or selected_variant.available == false %} hidden{% endif %}>● {{ block.settings.available_text | escape }}</span>
  <span data-bb-stock-low{% unless show_quantity %} hidden{% endunless %}>{{ block.settings.low_stock_prefix | escape }} <span data-bb-stock-quantity>{{ selected_variant.inventory_quantity }}</span> {{ block.settings.low_stock_suffix | escape }}</span>
  <span data-bb-stock-unavailable{% if selected_variant.available %} hidden{% endif %}>{{ block.settings.sold_out_text | escape }}</span>
  <script type="application/json" data-bb-variants>[{% for variant in product.variants %}{"id":{{ variant.id | json }},"available":{{ variant.available | json }},"quantity":{% if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' %}{{ variant.inventory_quantity | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
</div>
{% schema %}
{
  "name": "Stock Note",
  "target": "section",
  "stylesheet": "block-builder.css",
  "javascript": "stock-note.js",
  "settings": [
    {
      "type": "text",
      "id": "available_text",
      "label": "Available Text",
      "default": "Available and ready to ship"
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Sold Out Text",
      "default": "Currently unavailable"
    },
    { "type": "checkbox", "id": "show_low_stock", "label": "Show actual low stock", "default": false, "info": "Only for Shopify-tracked variants that cannot oversell." },
    { "type": "range", "id": "low_stock_threshold", "label": "Low stock threshold", "min": 1, "max": 50, "step": 1, "default": 8 },
    { "type": "text", "id": "low_stock_prefix", "label": "Low stock prefix", "default": "Only" },
    { "type": "text", "id": "low_stock_suffix", "label": "Low stock suffix", "default": "left" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}

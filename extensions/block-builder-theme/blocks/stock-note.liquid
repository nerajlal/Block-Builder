{% assign selected_variant = product.selected_or_first_available_variant %}
<div class="bb-block bb-stock{% unless selected_variant.available %} bb-stock--out{% endunless %}" {% if block.settings.background_color != blank %} data-bb-bg{% endif %}{% if block.settings.text_color != blank %} data-bb-text{% endif %}{% if block.settings.border_color != blank %} data-bb-border{% endif %}{% if block.settings.accent_color != blank %} data-bb-accent{% endif %}{% if block.settings.background_color != blank or block.settings.text_color != blank or block.settings.border_color != blank or block.settings.accent_color != blank or block.settings.link_color != blank %} style="{% if block.settings.background_color != blank %}--bb-custom-bg:{{ block.settings.background_color | escape }};{% endif %}{% if block.settings.text_color != blank %}--bb-custom-text:{{ block.settings.text_color | escape }};{% endif %}{% if block.settings.border_color != blank %}--bb-custom-border:{{ block.settings.border_color | escape }};{% endif %}{% if block.settings.accent_color != blank %}--bb-custom-accent:{{ block.settings.accent_color | escape }};{% endif %}{% if block.settings.link_color != blank %}--bb-shipping-link:{{ block.settings.link_color | escape }};{% endif %}"{% endif %} data-bb-stock role="status" aria-live="polite">
  <span data-bb-stock-available{% unless selected_variant.available %} hidden{% endunless %}>● {{ block.settings.available_text | escape }}</span>
  <span data-bb-stock-unavailable{% if selected_variant.available %} hidden{% endif %}>{{ block.settings.sold_out_text | escape }}</span>
  <script type="application/json" data-bb-variants>[{% for variant in product.variants %}{"id":{{ variant.id | json }},"available":{{ variant.available | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script>
</div>
{% schema %}
{
  "name": "Stock Note",
  "target": "section",
  "stylesheet": "block-builder.css",
  "javascript": "stock-note.js",
  "settings": [
    {
      "type": "text",
      "id": "available_text",
      "label": "Available Text",
      "default": "Available and ready to ship"
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Sold Out Text",
      "default": "Currently unavailable"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design."
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}

{% assign has_media = false %}
{% if block.settings.layout == 'portrait_videos' %}
  {% if block.settings.video_1 != blank or block.settings.video_2 != blank or block.settings.video_3 != blank or block.settings.video_4 != blank %}{% assign has_media = true %}{% endif %}
{% elsif block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank %}{% assign has_media = true %}{% endif %}
{% if has_media %}
<div class="bb-block bb-gallery{% if block.settings.layout == 'portrait_videos' %} bb-gallery--portrait{% endif %}" {% if block.settings.background_color != blank %} data-bb-bg{% endif %}{% if block.settings.text_color != blank %} data-bb-text{% endif %}{% if block.settings.border_color != blank %} data-bb-border{% endif %}{% if block.settings.accent_color != blank %} data-bb-accent{% endif %}{% if block.settings.background_color != blank or block.settings.text_color != blank or block.settings.border_color != blank or block.settings.accent_color != blank %} style="{% if block.settings.background_color != blank %}--bb-custom-bg:{{ block.settings.background_color | escape }};{% endif %}{% if block.settings.text_color != blank %}--bb-custom-text:{{ block.settings.text_color | escape }};{% endif %}{% if block.settings.border_color != blank %}--bb-custom-border:{{ block.settings.border_color | escape }};{% endif %}{% if block.settings.accent_color != blank %}--bb-custom-accent:{{ block.settings.accent_color | escape }};{% endif %}"{% endif %} {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
  <div class="bb-gallery__track" role="region" aria-label="{% if block.settings.layout == 'portrait_videos' %}Short video gallery{% else %}Product image gallery{% endif %}" tabindex="0">
    {% if block.settings.layout == 'portrait_videos' %}
      {% for number in (1..4) %}
        {% assign key = 'video_' | append: number %}
        {% assign video = block.settings[key] %}
        {% if video != blank %}<div class="bb-gallery__item">{{ video | video_tag: controls: true, autoplay: false, loop: false, image_size: '600x' }}</div>{% endif %}
      {% endfor %}
    {% else %}
      {% for number in (1..3) %}
        {% assign key = 'image_' | append: number %}
        {% assign image = block.settings[key] %}
        {% if image != blank %}<div class="bb-gallery__item">{{ image | image_url: width: 800 | image_tag: loading: 'lazy' }}</div>{% endif %}
      {% endfor %}
    {% endif %}
  </div>
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>{% if block.settings.layout == 'portrait_videos' %}Choose Shopify-hosted videos for this gallery.{% else %}Select images to build your gallery.{% endif %}</div>{% endif %}
{% schema %}
{
  "name": "Product image gallery",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "javascript": "video-gallery.js",
  "settings": [
    { "type": "select", "id": "layout", "label": "Gallery type", "options": [{ "value": "images", "label": "Product images" }, { "value": "portrait_videos", "label": "Portrait videos" }], "default": "images" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A closer look"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    { "type": "video", "id": "video_1", "label": "Portrait video 1" },
    { "type": "video", "id": "video_2", "label": "Portrait video 2" },
    { "type": "video", "id": "video_3", "label": "Portrait video 3" },
    { "type": "video", "id": "video_4", "label": "Portrait video 4" },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design."
    }
  ]
}
{% endschema %}

{% assign has_image = false %}
{% if block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank %}{% assign has_image = true %}{% endif %}
{% if has_image %}
<div class="bb-block bb-gallery" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
  <div class="bb-gallery__track" role="region" aria-label="Product image gallery" tabindex="0">
    {% for number in (1..3) %}
      {% assign key = 'image_' | append: number %}
      {% assign image = block.settings[key] %}
      {% if image != blank %}<div class="bb-gallery__item">{{ image | image_url: width: 800 | image_tag: loading: 'lazy' }}</div>{% endif %}
    {% endfor %}
  </div>
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Select images to build your gallery.</div>{% endif %}
{% schema %}
{
  "name": "Product image gallery",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A closer look"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    }
  ]
}
{% endschema %}

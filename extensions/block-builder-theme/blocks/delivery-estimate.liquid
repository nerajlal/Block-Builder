{% assign sk_smart_delivery = false %}
{% if app.metafields.sectionkit.pro_enabled.value == true and block.settings.delivery_mode == 'smart' %}{% assign sk_smart_delivery = true %}{% endif %}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-delivery"{% if sk_smart_delivery %} data-bb-smart-delivery data-bb-min-days="{{ block.settings.min_days }}" data-bb-max-days="{{ block.settings.max_days }}" data-bb-cutoff-hour="{{ block.settings.cutoff_hour }}" data-bb-timezone="{{ block.settings.timezone | escape }}" data-bb-weekdays-only="{{ block.settings.weekdays_only }}" data-bb-holidays="{{ block.settings.holiday_dates | escape }}" data-bb-country-rules="{{ block.settings.country_rules | escape }}" data-bb-country="{{ localization.country.iso_code | escape }}" data-bb-prefix="{{ block.settings.smart_prefix | escape }}"{% endif %}{% render "sectionkit-colors", block: block %}><strong>🚚 {{ block.settings.heading | escape }}</strong><div data-bb-delivery-message>{{ block.settings.message | escape }}</div><small>{{ block.settings.disclaimer | escape }}</small></div>
{% schema %}
{"name":"Delivery Estimate","target":"section","stylesheet":"block-builder.css","javascript":"delivery-estimate.js","settings":[{"type":"text","id":"heading","label":"Heading","default":"Delivery information"},{"type":"text","id":"message","label":"Message","default":"Estimated delivery in 3–5 business days"},{"type":"text","id":"disclaimer","label":"Disclaimer","default":"Delivery times are estimates and may vary by location."},{"type":"header","content":"Pro: smart delivery"},{"type":"select","id":"delivery_mode","label":"Delivery mode (Pro only)","options":[{"value":"fixed","label":"Fixed message"},{"value":"smart","label":"Calculated dates"}],"default":"fixed"},{"type":"text","id":"smart_prefix","label":"Calculated date label","default":"Estimated delivery:"},{"type":"range","id":"min_days","label":"Minimum days","min":1,"max":30,"step":1,"default":3},{"type":"range","id":"max_days","label":"Maximum days","min":1,"max":30,"step":1,"default":5},{"type":"range","id":"cutoff_hour","label":"Daily order cutoff (0–23)","min":0,"max":23,"step":1,"default":15},{"type":"checkbox","id":"weekdays_only","label":"Skip weekends","default":true},{"type":"text","id":"timezone","label":"Store timezone (IANA)","default":"UTC","info":"Set your shipping cutoff timezone, for example Europe/London. UTC is used until you change it."},{"type":"textarea","id":"holiday_dates","label":"Holiday dates to skip","info":"One YYYY-MM-DD date per line."},{"type":"textarea","id":"country_rules","label":"Country-specific day ranges","info":"One rule per line, for example US=2-4 or GB=3-6. Use two-letter country codes."},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}],"enabled_on":{"templates":["product"]}}
{% endschema %}

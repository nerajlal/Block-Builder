{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
{% if block.settings.value_1 != blank or block.settings.value_2 != blank or block.settings.value_3 != blank %}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-specs"{% render "sectionkit-colors", block: block %} {{ block.shopify_attributes }}><h3>{{ block.settings.heading | escape }}</h3><dl>{% if block.settings.value_1 != blank %}<div><dt>{{ block.settings.label_1 | escape }}</dt><dd>{{ block.settings.value_1 | escape }}</dd></div>{% endif %}{% if block.settings.value_2 != blank %}<div><dt>{{ block.settings.label_2 | escape }}</dt><dd>{{ block.settings.value_2 | escape }}</dd></div>{% endif %}{% if block.settings.value_3 != blank %}<div><dt>{{ block.settings.label_3 | escape }}</dt><dd>{{ block.settings.value_3 | escape }}</dd></div>{% endif %}</dl></div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Add factual specifications to show this block.</div>{% endif %}
{%- endif -%}
{% schema %}
{"name":"Specification list","target":"section","available_if":"{{ app.metafields.sectionkit.allow_specification_list }}","enabled_on":{"templates":["product"]},"stylesheet":"block-builder.css","settings":[{"type":"text","id":"heading","label":"Heading","default":"Product details"},{"type":"text","id":"label_1","label":"Label 1","default":"Material"},{"type":"text","id":"value_1","label":"Value 1"},{"type":"text","id":"label_2","label":"Label 2","default":"Dimensions"},{"type":"text","id":"value_2","label":"Value 2"},{"type":"text","id":"label_3","label":"Label 3","default":"Care"},{"type":"text","id":"value_3","label":"Value 3"},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}]}
{% endschema %}

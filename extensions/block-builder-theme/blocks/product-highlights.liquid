{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-highlights bb-highlights--{{ block.settings.style | escape }}" {% if block.settings.background_color != blank %} data-bb-bg{% endif %}{% if block.settings.text_color != blank %} data-bb-text{% endif %}{% if block.settings.border_color != blank %} data-bb-border{% endif %}{% if block.settings.accent_color != blank %} data-bb-accent{% endif %}{% if block.settings.background_color != blank or block.settings.text_color != blank or block.settings.border_color != blank or block.settings.accent_color != blank %} style="{% if block.settings.background_color != blank %}--bb-custom-bg:{{ block.settings.background_color | escape }};{% endif %}{% if block.settings.text_color != blank %}--bb-custom-text:{{ block.settings.text_color | escape }};{% endif %}{% if block.settings.border_color != blank %}--bb-custom-border:{{ block.settings.border_color | escape }};{% endif %}{% if block.settings.accent_color != blank %}--bb-custom-accent:{{ block.settings.accent_color | escape }};{% endif %}"{% endif %}><span>✦ {{ block.settings.first | escape }}</span><span>✦ {{ block.settings.second | escape }}</span><span>✦ {{ block.settings.third | escape }}</span></div>
{%- endif -%}
{% schema %}
{
  "name": "Product Highlights",
  "target": "section",
  "available_if": "{{ app.metafields.sectionkit.allow_product_highlights }}",
  "stylesheet": "block-builder.css",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Design",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "warm",
          "label": "Warm"
        }
      ],
      "default": "standard"
    },
    {
      "type": "text",
      "id": "first",
      "label": "First",
      "default": "Made for everyday use"
    },
    {
      "type": "text",
      "id": "second",
      "label": "Second",
      "default": "Built to last"
    },
    {
      "type": "text",
      "id": "third",
      "label": "Third",
      "default": "Easy to care for"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design. Custom colors require Starter or Pro."
},
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design. Custom colors require Starter or Pro."
},
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design. Custom colors require Starter or Pro."
},
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design. Custom colors require Starter or Pro."
},
    {"type": "header", "content": "Pro: display targeting"},
    {"type": "textarea", "id": "pro_product_handles", "label": "Product handles (Pro only)", "info": "Comma-separated handles. Leave empty for all products."},
    {"type": "textarea", "id": "pro_collection_handles", "label": "Collection handles (Pro only)", "info": "Comma-separated handles. Match any collection."},
    {"type": "textarea", "id": "pro_tags", "label": "Product tags (Pro only)", "info": "Comma-separated tags. Match any tag."},
    {"type": "text", "id": "pro_countries", "label": "Country codes (Pro only)", "info": "Comma-separated two-letter market country codes."},
    {"type": "text", "id": "pro_languages", "label": "Language codes (Pro only)", "info": "Comma-separated language codes, for example en,fr."}
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}

{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-highlights bb-highlights--{{ block.settings.style | escape }}"{% render "sectionkit-colors", block: block %}><span>✦ {{ block.settings.first | escape }}</span><span>✦ {{ block.settings.second | escape }}</span><span>✦ {{ block.settings.third | escape }}</span></div>
{%- endif -%}
{% schema %}
{"name":"Product Highlights","target":"section","stylesheet":"block-builder.css","settings":[{"type":"select","id":"style","label":"Design","options":[{"value":"standard","label":"Standard"},{"value":"outline","label":"Outline"},{"value":"warm","label":"Warm"}],"default":"standard"},{"type":"text","id":"first","label":"First","default":"Made for everyday use"},{"type":"text","id":"second","label":"Second","default":"Built to last"},{"type":"text","id":"third","label":"Third","default":"Easy to care for"},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}],"enabled_on":{"templates":["product"]}}
{% endschema %}

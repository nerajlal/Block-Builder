{% if block.settings.video != blank %}
<div class="bb-block bb-video" {% if block.settings.background_color != blank %} data-bb-bg{% endif %}{% if block.settings.text_color != blank %} data-bb-text{% endif %}{% if block.settings.border_color != blank %} data-bb-border{% endif %}{% if block.settings.accent_color != blank %} data-bb-accent{% endif %}{% if block.settings.background_color != blank or block.settings.text_color != blank or block.settings.border_color != blank or block.settings.accent_color != blank %} style="{% if block.settings.background_color != blank %}--bb-custom-bg:{{ block.settings.background_color | escape }};{% endif %}{% if block.settings.text_color != blank %}--bb-custom-text:{{ block.settings.text_color | escape }};{% endif %}{% if block.settings.border_color != blank %}--bb-custom-border:{{ block.settings.border_color | escape }};{% endif %}{% if block.settings.accent_color != blank %}--bb-custom-accent:{{ block.settings.accent_color | escape }};{% endif %}"{% endif %} {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
  {{ block.settings.video | video_tag: controls: true, autoplay: false, loop: false }}
  {% if block.settings.caption != blank %}<p>{{ block.settings.caption | escape }}</p>{% endif %}
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Choose a video from Shopify files to show it here.</div>{% endif %}
{% schema %}
{
  "name": "Product video",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See it in action"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Product video"
    },
    {
      "type": "textarea",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design."
    }
  ]
}
{% endschema %}

<button class="bb-scroll-top" type="button" aria-label="{{ block.settings.label | escape }}" data-bb-scroll-top {{ block.shopify_attributes }}>
  <span aria-hidden="true">↑</span>
</button>

{% schema %}
{
  "name": "Scroll to Top",
  "target": "body",
  "stylesheet": "block-builder.css",
  "javascript": "scroll-to-top.js",
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible button label", "default": "Back to top" }
  ]
}
{% endschema %}

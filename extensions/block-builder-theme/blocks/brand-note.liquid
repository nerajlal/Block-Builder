{% if block.settings.message != blank %}<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-brand-note"{% render "sectionkit-colors", block: block %} {{ block.shopify_attributes }}><span>{{ block.settings.eyebrow | escape }}</span><blockquote>{{ block.settings.message | escape | newline_to_br }}</blockquote>{% if block.settings.attribution != blank %}<p>— {{ block.settings.attribution | escape }}</p>{% endif %}</div>{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Add your own brand note to show this block.</div>{% endif %}
{% schema %}
{"name":"Brand note","target":"section","enabled_on":{"templates":["product"]},"stylesheet":"block-builder.css","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"From our team"},{"type":"textarea","id":"message","label":"Your brand note","info":"Write your own text; do not imply a customer testimonial."},{"type":"text","id":"attribution","label":"Optional attribution"},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}]}
{% endschema %}

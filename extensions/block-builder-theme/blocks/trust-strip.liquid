<div class="bb-block bb-trust bb-trust--{{ block.settings.style | escape }}" {% if block.settings.background_color != blank %} data-bb-bg{% endif %}{% if block.settings.text_color != blank %} data-bb-text{% endif %}{% if block.settings.border_color != blank %} data-bb-border{% endif %}{% if block.settings.accent_color != blank %} data-bb-accent{% endif %}{% if block.settings.background_color != blank or block.settings.text_color != blank or block.settings.border_color != blank or block.settings.accent_color != blank %} style="{% if block.settings.background_color != blank %}--bb-custom-bg:{{ block.settings.background_color | escape }};{% endif %}{% if block.settings.text_color != blank %}--bb-custom-text:{{ block.settings.text_color | escape }};{% endif %}{% if block.settings.border_color != blank %}--bb-custom-border:{{ block.settings.border_color | escape }};{% endif %}{% if block.settings.accent_color != blank %}--bb-custom-accent:{{ block.settings.accent_color | escape }};{% endif %}"{% endif %} {{ block.shopify_attributes }}><span>✓ {{ block.settings.first | escape }}</span><span>✓ {{ block.settings.second | escape }}</span><span>✓ {{ block.settings.third | escape }}</span></div>
{% schema %}
{
  "name": "Trust Strip",
  "target": "section",
  "stylesheet": "block-builder.css",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Design",
      "options": [
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "soft"
    },
    {
      "type": "text",
      "id": "first",
      "label": "First",
      "default": "Secure checkout"
    },
    {
      "type": "text",
      "id": "second",
      "label": "Second",
      "default": "Easy returns"
    },
    {
      "type": "text",
      "id": "third",
      "label": "Third",
      "default": "Friendly support"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design."
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}

{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-trust bb-trust--{{ block.settings.style | escape }}"{% render "sectionkit-colors", block: block %} {{ block.shopify_attributes }}><span>✓ {{ block.settings.first | escape }}</span><span>✓ {{ block.settings.second | escape }}</span><span>✓ {{ block.settings.third | escape }}</span></div>
{%- endif -%}
{% schema %}
{"name":"Trust Strip","target":"section","available_if":"{{ app.metafields.sectionkit.allow_trust_strip }}","stylesheet":"block-builder.css","settings":[{"type":"select","id":"style","label":"Design","options":[{"value":"soft","label":"Soft"},{"value":"outline","label":"Outline"},{"value":"dark","label":"Dark"}],"default":"soft"},{"type":"text","id":"first","label":"First","default":"Secure checkout"},{"type":"text","id":"second","label":"Second","default":"Easy returns"},{"type":"text","id":"third","label":"Third","default":"Friendly support"},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}],"enabled_on":{"templates":["product"]}}
{% endschema %}

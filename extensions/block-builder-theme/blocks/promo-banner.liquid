{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-promo bb-promo--{{ block.settings.style | escape }}"{% render "sectionkit-colors", block: block %} data-bb-promo-end="{{ block.settings.ends_at | escape }}" {{ block.shopify_attributes }}><strong>{% if block.settings.style == "black-friday" %}<span aria-hidden="true">◷ </span>{% endif %}{{ block.settings.heading | escape }}</strong><div>{{ block.settings.message | escape }}</div>{% if block.settings.ends_at != blank %}<span class="bb-promo__countdown" data-bb-promo-countdown hidden></span>{% endif %}{% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div>
{%- endif -%}
{% schema %}
{"name":"Promo Banner","target":"section","stylesheet":"block-builder.css","javascript":"promo-banner.js","settings":[{"type":"select","id":"style","label":"Design","options":[{"value":"dark","label":"Dark"},{"value":"cream","label":"Cream"},{"value":"outline","label":"Outline"},{"value":"black-friday","label":"Black Friday"}],"default":"dark"},{"type":"text","id":"heading","label":"Heading","default":"A little extra for your next order"},{"type":"text","id":"message","label":"Message","default":"Explore our latest offers"},{"type":"text","id":"ends_at","label":"Campaign end date and time","info":"Optional ISO 8601 date with timezone, for example 2026-12-01T23:59:00+05:30. The banner hides after this time."},{"type":"url","id":"link","label":"Optional link"},{"type":"text","id":"link_label","label":"Link label","default":"Learn more"},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}],"enabled_on":{"templates":["product"]}}
{% endschema %}

{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-promo bb-promo--{{ block.settings.style | escape }}" {% if block.settings.background_color != blank %} data-bb-bg{% endif %}{% if block.settings.text_color != blank %} data-bb-text{% endif %}{% if block.settings.border_color != blank %} data-bb-border{% endif %}{% if block.settings.accent_color != blank %} data-bb-accent{% endif %}{% if block.settings.background_color != blank or block.settings.text_color != blank or block.settings.border_color != blank or block.settings.accent_color != blank %} style="{% if block.settings.background_color != blank %}--bb-custom-bg:{{ block.settings.background_color | escape }};{% endif %}{% if block.settings.text_color != blank %}--bb-custom-text:{{ block.settings.text_color | escape }};{% endif %}{% if block.settings.border_color != blank %}--bb-custom-border:{{ block.settings.border_color | escape }};{% endif %}{% if block.settings.accent_color != blank %}--bb-custom-accent:{{ block.settings.accent_color | escape }};{% endif %}"{% endif %} data-bb-promo-end="{{ block.settings.ends_at | escape }}" {{ block.shopify_attributes }}><strong>{% if block.settings.style == "black-friday" %}<span aria-hidden="true">◷ </span>{% endif %}{{ block.settings.heading | escape }}</strong><div>{{ block.settings.message | escape }}</div>{% if block.settings.ends_at != blank %}<span class="bb-promo__countdown" data-bb-promo-countdown hidden></span>{% endif %}{% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div>
{%- endif -%}
{% schema %}
{
  "name": "Promo Banner",
  "target": "section",
  "available_if": "{{ app.metafields.sectionkit.allow_promo_banner }}",
  "stylesheet": "block-builder.css",
  "javascript": "promo-banner.js",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Design",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        { "value": "black-friday", "label": "Black Friday" }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little extra for your next order"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Explore our latest offers"
    },
    { "type": "text", "id": "ends_at", "label": "Campaign end date and time", "info": "Optional ISO 8601 date with timezone, for example 2026-12-01T23:59:00+05:30. The banner hides after this time." },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Learn more"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design. Custom colors require Starter or Pro."
},
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design. Custom colors require Starter or Pro."
},
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design. Custom colors require Starter or Pro."
},
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design. Custom colors require Starter or Pro."
},
    {"type": "header", "content": "Pro: display targeting"},
    {"type": "textarea", "id": "pro_product_handles", "label": "Product handles (Pro only)", "info": "Comma-separated handles. Leave empty for all products."},
    {"type": "textarea", "id": "pro_collection_handles", "label": "Collection handles (Pro only)", "info": "Comma-separated handles. Match any collection."},
    {"type": "textarea", "id": "pro_tags", "label": "Product tags (Pro only)", "info": "Comma-separated tags. Match any tag."},
    {"type": "text", "id": "pro_countries", "label": "Country codes (Pro only)", "info": "Comma-separated two-letter market country codes."},
    {"type": "text", "id": "pro_languages", "label": "Language codes (Pro only)", "info": "Comma-separated language codes, for example en,fr."}
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}

<div class="bb-block bb-promo bb-promo--{{ block.settings.style | escape }}" {% if block.settings.background_color != blank %} data-bb-bg{% endif %}{% if block.settings.text_color != blank %} data-bb-text{% endif %}{% if block.settings.border_color != blank %} data-bb-border{% endif %}{% if block.settings.accent_color != blank %} data-bb-accent{% endif %}{% if block.settings.background_color != blank or block.settings.text_color != blank or block.settings.border_color != blank or block.settings.accent_color != blank %} style="{% if block.settings.background_color != blank %}--bb-custom-bg:{{ block.settings.background_color | escape }};{% endif %}{% if block.settings.text_color != blank %}--bb-custom-text:{{ block.settings.text_color | escape }};{% endif %}{% if block.settings.border_color != blank %}--bb-custom-border:{{ block.settings.border_color | escape }};{% endif %}{% if block.settings.accent_color != blank %}--bb-custom-accent:{{ block.settings.accent_color | escape }};{% endif %}"{% endif %} data-bb-promo-end="{{ block.settings.ends_at | escape }}" {{ block.shopify_attributes }}><strong>{{ block.settings.heading | escape }}</strong><div>{{ block.settings.message | escape }}</div>{% if block.settings.ends_at != blank %}<span class="bb-promo__countdown" data-bb-promo-countdown hidden></span>{% endif %}{% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}</div>
{% schema %}
{
  "name": "Promo Banner",
  "target": "section",
  "stylesheet": "block-builder.css",
  "javascript": "promo-banner.js",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Design",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "outline",
          "label": "Outline"
        }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little extra for your next order"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Explore our latest offers"
    },
    { "type": "text", "id": "ends_at", "label": "Campaign end date and time", "info": "Optional ISO 8601 date with timezone, for example 2026-12-01T23:59:00+05:30. The banner hides after this time." },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Learn more"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design."
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}

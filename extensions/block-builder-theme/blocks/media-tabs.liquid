{% assign has_media = false %}
{% if block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank or block.settings.video_1 != blank or block.settings.video_2 != blank or block.settings.video_3 != blank %}{% assign has_media = true %}{% endif %}
{% if has_media %}
<div class="bb-block bb-media-tabs bb-media-tabs--{{ block.settings.display_style | escape }}" {% if block.settings.background_color != blank %} data-bb-bg{% endif %}{% if block.settings.text_color != blank %} data-bb-text{% endif %}{% if block.settings.border_color != blank %} data-bb-border{% endif %}{% if block.settings.accent_color != blank %} data-bb-accent{% endif %}{% if block.settings.background_color != blank or block.settings.text_color != blank or block.settings.border_color != blank or block.settings.accent_color != blank %} style="{% if block.settings.background_color != blank %}--bb-custom-bg:{{ block.settings.background_color | escape }};{% endif %}{% if block.settings.text_color != blank %}--bb-custom-text:{{ block.settings.text_color | escape }};{% endif %}{% if block.settings.border_color != blank %}--bb-custom-border:{{ block.settings.border_color | escape }};{% endif %}{% if block.settings.accent_color != blank %}--bb-custom-accent:{{ block.settings.accent_color | escape }};{% endif %}"{% endif %} data-bb-info-tabs{% if block.settings.display_style == "slideshow" %} data-bb-media-slider{% endif %} {{ block.shopify_attributes }}>
  <div class="bb-media-tabs__tabs" role="tablist" aria-label="Product media">
    {% for number in (1..3) %}
      {% assign image_key = 'image_' | append: number %}
      {% assign image = block.settings[image_key] %}
      {% assign video_key = 'video_' | append: number %}
      {% assign video = block.settings[video_key] %}
      {% if image != blank or video != blank %}
        {% assign title_key = 'title_' | append: number %}
        <button type="button" role="tab" id="bb-media-tab-{{ block.id }}-{{ number }}" aria-controls="bb-media-panel-{{ block.id }}-{{ number }}" aria-selected="false" tabindex="-1">{{ block.settings[title_key] | escape }}</button>
      {% endif %}
    {% endfor %}
  </div>
  {% for number in (1..3) %}
    {% assign image_key = 'image_' | append: number %}
    {% assign image = block.settings[image_key] %}
    {% assign video_key = 'video_' | append: number %}
    {% assign video = block.settings[video_key] %}
    {% if image != blank or video != blank %}
      {% assign body_key = 'body_' | append: number %}
      <div class="bb-media-tabs__panel" role="tabpanel" id="bb-media-panel-{{ block.id }}-{{ number }}" aria-labelledby="bb-media-tab-{{ block.id }}-{{ number }}" hidden>
        {% if video != blank %}{{ video | video_tag: controls: true, image_size: '1000x' }}{% else %}{{ image | image_url: width: 1000 | image_tag: loading: 'lazy' }}{% endif %}
        {% if block.settings[body_key] != blank %}<p>{{ block.settings[body_key] | escape }}</p>{% endif %}
      </div>
    {% endif %}
  {% endfor %}
  {% if block.settings.display_style == "slideshow" %}<div class="bb-media-tabs__controls"><button type="button" data-bb-slide="previous" aria-label="Previous image">←</button><button type="button" data-bb-slide="next" aria-label="Next image">→</button></div>{% endif %}
</div>
{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Choose an image or video to create media tabs.</div>{% endif %}
{% schema %}
{
  "name": "Media tabs",
  "target": "section",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "stylesheet": "block-builder.css",
  "settings": [
    { "type": "select", "id": "display_style", "label": "Display", "options": [{ "value": "tabs", "label": "Tabs" }, { "value": "slideshow", "label": "Image slider" }], "default": "tabs" },
    {
      "type": "text",
      "id": "title_1",
      "label": "Tab 1 title",
      "default": "Detail 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Tab 1 image"
    },
    { "type": "video", "id": "video_1", "label": "Tab 1 video", "info": "Video takes priority over the image." },
    {
      "type": "textarea",
      "id": "body_1",
      "label": "Tab 1 description"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Tab 2 title",
      "default": "Detail 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Tab 2 image"
    },
    { "type": "video", "id": "video_2", "label": "Tab 2 video", "info": "Video takes priority over the image." },
    {
      "type": "textarea",
      "id": "body_2",
      "label": "Tab 2 description"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Tab 3 title",
      "default": "Detail 3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Tab 3 image"
    },
    { "type": "video", "id": "video_3", "label": "Tab 3 video", "info": "Video takes priority over the image." },
    {
      "type": "textarea",
      "id": "body_3",
      "label": "Tab 3 description"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty to use the widget design."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Leave empty to use the widget design."
    }
  ],
  "javascript": "info-tabs.js"
}
{% endschema %}

{%- capture sk_visibility -%}{%- render "sectionkit-visibility", block: block, product: product, localization: localization -%}{%- endcapture -%}
{%- if sk_visibility == "show" -%}
{% if block.settings.item_1 != blank and block.settings.item_2 != blank and block.settings.item_3 != blank %}<div data-bb-paid="{{ app.metafields.sectionkit.paid_enabled.value }}" class="bb-block bb-checklist"{% render "sectionkit-colors", block: block %} {{ block.shopify_attributes }}><h3>{{ block.settings.heading | escape }}</h3><ul><li>{{ block.settings.item_1 | escape }}</li><li>{{ block.settings.item_2 | escape }}</li><li>{{ block.settings.item_3 | escape }}</li></ul></div>{% elsif request.design_mode %}<div class="bb-block bb-editor-note" {{ block.shopify_attributes }}>Enter three factual product points to show this block.</div>{% endif %}
{%- endif -%}
{% schema %}
{"name":"Product checklist","target":"section","enabled_on":{"templates":["product"]},"stylesheet":"block-builder.css","settings":[{"type":"text","id":"heading","label":"Heading","default":"At a glance"},{"type":"text","id":"item_1","label":"Item 1","info":"Use a factual point about this product."},{"type":"text","id":"item_2","label":"Item 2","info":"Use a factual point about this product."},{"type":"text","id":"item_3","label":"Item 3","info":"Use a factual point about this product."},{"type":"color","id":"background_color","label":"Background color"},{"type":"color","id":"text_color","label":"Text color"},{"type":"color","id":"border_color","label":"Border color"},{"type":"color","id":"accent_color","label":"Accent color"},{"type":"header","content":"Pro: display targeting"},{"type":"textarea","id":"pro_product_handles","label":"Product handles (Pro only)","info":"Comma-separated; empty means all."},{"type":"textarea","id":"pro_collection_handles","label":"Collection handles (Pro only)","info":"Comma-separated collection handles."},{"type":"textarea","id":"pro_tags","label":"Product tags (Pro only)","info":"Comma-separated product tags."},{"type":"text","id":"pro_countries","label":"Country codes (Pro only)","info":"Two-letter country codes, comma-separated."},{"type":"text","id":"pro_languages","label":"Language codes (Pro only)","info":"Language codes, comma-separated."}]}
{% endschema %}
